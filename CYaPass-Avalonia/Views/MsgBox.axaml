<Window xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="CYaPass_Avalonia.Views.MsgBox"
        Width="300" Height="230"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Name="CancelBtn" IsVisible="false" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
