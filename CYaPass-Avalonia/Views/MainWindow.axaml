<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CYaPass_Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CYaPass_Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:local="clr-namespace:CYaPass_Avalonia.Models"
        Icon="/Assets/avalonia-logo.ico"
        Title="CYaPass"
        Padding="20"
        Background="WhiteSmoke">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column -->
        <StackPanel Grid.Column="0" Background="LightBlue"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

      <Grid HorizontalAlignment="Left" VerticalAlignment="Top" 
         RowDefinitions="Auto,Auto,Auto,Auto,300,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
         ColumnDefinitions="" Width="500">
            <Label Target="siteKeyLabel" Grid.Row="0" Grid.Column="0">1. Select (or Add) Site/Key</Label>
            <ListBox SelectionChanged="SiteKeyChanged" SelectionMode="AlwaysSelected" Name="SiteKeys" Grid.Row="1" Grid.Column="0" Grid.RowSpan="4"
            ItemsSource="{Binding allSiteKeys.Items}" />
            
            
            <StackPanel Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Click="OnAddSiteKeyClick" IsDefault="True" >Add</Button>
              <Button Click="AddTestSiteKeys" >Edit</Button>
              <Button Click="DeleteSiteKey">Delete</Button>
            </StackPanel>
            
            <StackPanel Grid.Column="0" Grid.Row="7" Orientation="Horizontal">
               <CheckBox Name="MultiHashCB" IsCheckedChanged="MultiHashCheckChanged" IsThreeState="False" >Use Multi-Hash</CheckBox>
               <NumericUpDown ValueChanged="MultiHashChanged" Name="MultiHashUD" Width="200" Maximum="500" Value="0"
               Minimum="0" ParsingNumberStyle="Integer" FormatString="0"></NumericUpDown>
            </StackPanel>
            <CheckBox IsCheckedChanged="AddUppercaseChanged" Grid.Column="0" Grid.Row="8" >Add Uppercase</CheckBox>
            <StackPanel Grid.Column="0" Grid.Row="9" Orientation="Horizontal">
               <CheckBox  >Add Special Chars</CheckBox>
               <TextBox Width="200"></TextBox>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="10" Orientation="Horizontal">
              <CheckBox IsCheckedChanged="MaxLengthChanged" Name="MaxLengthCB" >Max Length</CheckBox>
               <NumericUpDown Name="MaxLengthUD" Width="200" Maximum="64" Value="0" ValueChanged="MaxLengthChanged" 
               Minimum="0" ParsingNumberStyle="Integer" FormatString="0"></NumericUpDown>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left">
              <Button>Export SiteKeys</Button>
              <Button Click="ImportSiteKeys">Import SiteKeys</Button>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left">
              <Button>Set Transfer URL</Button>
              <Button>Remove All SiteKeys</Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Right column -->
        <StackPanel Grid.Column="1" Background="LightYellow"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            
      <Grid HorizontalAlignment="Left" VerticalAlignment="Top" 
         RowDefinitions="Auto,Auto,Auto,Auto,300,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
         ColumnDefinitions="" Width="500">
            
            <Label Target="PwdGridLabel" Grid.Row="0" Grid.Column="0">2. Draw a pattern</Label>
            <local:PwdGrid Name="PwdGrid" Width="250" Height="250" Grid.Row="1" Grid.Column="0" Grid.RowSpan="4"/>
            <StackPanel Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox Name="HidePatternCheckBox" Click="SetHidePattern">Hide Pattern</CheckBox>
              <Button Click="ClearHandler">Clear</Button>
            </StackPanel>
            <TextBox Text="{Binding #PwdGrid.GeneratedPassword}" Name="PwdTextBox" Grid.Row="12" Grid.Column="0" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
            TextChanged="PasswordTextChanged"/>
         </Grid>
        </StackPanel>
    </Grid>
</Window>
